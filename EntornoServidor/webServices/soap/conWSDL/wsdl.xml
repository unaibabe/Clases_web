<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="http://localhost/soap/conWSDL/calcular.php"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://localhost/soap/conWSDL/calcular.php"
                  name="CalculatorService">

    <wsdl:message name="operacionRequest">
        <wsdl:part name="num1" type="xsd:float"/>
        <wsdl:part name="num2" type="xsd:float"/>
    </wsdl:message>
    <wsdl:message name="operacionResponse">
        <wsdl:part name="resultado" type="xsd:float"/>
    </wsdl:message>

    <wsdl:portType name="CalculatorPortType">
        <wsdl:operation name="sumar">
            <wsdl:input message="tns:operacionRequest"/>
            <wsdl:output message="tns:operacionResponse"/>
        </wsdl:operation>
        <wsdl:operation name="restar">
            <wsdl:input message="tns:operacionRequest"/>
            <wsdl:output message="tns:operacionResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="CalculatorBinding" type="tns:CalculatorPortType">
        <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
        
        <wsdl:operation name="sumar">
            <soap:operation soapAction="http://localhost/soap/conWSDL/calcular.php#sumar"/>
            <wsdl:input><soap:body use="encoded" namespace="http://localhost/soap/conWSDL/calcular.php" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:input>
            <wsdl:output><soap:body use="encoded" namespace="http://localhost/soap/conWSDL/calcular.php" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:output>
        </wsdl:operation>

        <wsdl:operation name="restar">
            <soap:operation soapAction="http://localhost/soap/conWSDL/calcular.php#restar"/>
            <wsdl:input><soap:body use="encoded" namespace="http://localhost/soap/conWSDL/calcular.php" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:input>
            <wsdl:output><soap:body use="encoded" namespace="http://localhost/soap/conWSDL/calcular.php" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="CalculatorService">
        <wsdl:port name="CalculatorPort" binding="tns:CalculatorBinding">
            <soap:address location="http://localhost/soap/conWSDL/calcular.php"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>